# LivePilot Web 的示例服务端配置。复制为 .env.local 后填写，切勿提交真实值。
# 在 Google Cloud Console 中创建 Web application OAuth Client。
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret

# 两个地址必须与 Google Cloud 中登记的 Authorized redirect URI 完全一致。
LIVEPILOT_BASE_URL=http://127.0.0.1:3000
YOUTUBE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# 至少 32 个随机字节；仅用于服务端加密 token、OAuth transaction 和会话材料。
LIVEPILOT_APP_SECRET=replace-with-at-least-32-random-bytes

# 可选。默认写入仓库根目录下被 Git 忽略的 .data。
LIVEPILOT_DATA_DIR=.data

# Windows 本地媒体根目录；用分号分隔多个目录，浏览器只能选择扫描出的资源 ID。
LIVEPILOT_MEDIA_ROOTS=D:\\LiveMedia

# 可选：默认使用 ffmpeg-static；仅在需要指定受审计的本机 ffmpeg.exe 时设置。
# LIVEPILOT_FFMPEG_PATH=D:\\Tools\\ffmpeg\\bin\\ffmpeg.exe
